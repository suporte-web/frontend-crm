# Valores VITE_* são públicos e incorporados ao build. Não colocar credenciais aqui.
VITE_API_BACKEND=/api
# VITE_API_URL também é aceito por compatibilidade com a migração anterior.
VITE_SITE_PUBLIC_URL=http://localhost:3002

# Exclusivos do servidor Vite (não expostos ao navegador).
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Vazio para o NestJS atual sem prefixo global. Use /api se o backend adicionar esse prefixo.
BACKEND_API_PREFIX=
